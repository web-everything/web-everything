<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	STAGED, NOT INSTALLED (#4077, health daemon slice 1; ruling #4065). The operator installs it by hand; no
	session writes into ~/Library/LaunchAgents/ or runs `launchctl` on the operator's behalf.

	BEFORE INSTALLING:
	  1. Make the health watch's OWN dedicated clone (4065 Fork 1: shared with no other daemon, so no other
	     daemon's overlay or conflicted self-sync can take the watcher down with the watched):
	       git clone https://github.com/web-everything/web-everything.git ~/workspace/wev-health-watch
	       cd ~/workspace/wev-health-watch && npm ci
	  2. Replace <app-id>, <installation-id>, <path-to-private-key.pem> with the real GitHub App values (never
	     commit them). The watch's `gh pr list` then draws on the App's budget, not the operator's.
	  3. CONVEYOR_STATE_ROOT pins the episode store to the operator's primary checkout (#4052), so
	     `operator-queue.mjs --with-health` (and `health-watch.mjs section`) run from that
	     checkout read the same store the daemon writes: <root>/.conveyor/health/.
	  4. HEALTH_WATCH_LOGS_DIR is where the other daemons' launchd logs live (their StandardErrorPath dir).
	  5. PASS_DAEMON_SELF_SYNC=1 turns self-sync ON explicitly for this pass-daemon (it is opt-in on that runner).

	INSTALL:  cp this file to ~/Library/LaunchAgents/com.we.health-watch.plist (drop `.example`), then
	          launchctl load ~/Library/LaunchAgents/com.we.health-watch.plist
	CHECK:    node ~/workspace/webeverything/scripts/operations/operator-queue.mjs --with-health   (first line = last-tick age)
	-->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/nicolasgilbert/.nvm/versions/node/v22.1.0/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>WE_GITHUB_APP_ID</key>
		<string>&lt;app-id&gt;</string>
		<key>WE_GITHUB_APP_INSTALLATION_ID</key>
		<string>&lt;installation-id&gt;</string>
		<key>WE_GITHUB_APP_PRIVATE_KEY_PATH</key>
		<string>&lt;path-to-private-key.pem&gt;</string>
		<key>CONVEYOR_STATE_ROOT</key>
		<string>/Users/nicolasgilbert/workspace/webeverything</string>
		<key>HEALTH_WATCH_LOGS_DIR</key>
		<string>/Users/nicolasgilbert/workspace/wev-review-daemon/.conveyor</string>
		<key>PASS_DAEMON_SELF_SYNC</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.we.health-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nicolasgilbert/.nvm/versions/node/v22.1.0/bin/node</string>
		<string>/Users/nicolasgilbert/workspace/wev-health-watch/skills-src/conveyor/pass-daemon.mjs</string>
		<string>--pass=health-watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/nicolasgilbert/workspace/wev-health-watch/.conveyor/health-watch.log</string>
	<key>StandardOutPath</key>
	<string>/Users/nicolasgilbert/workspace/wev-health-watch/.conveyor/health-watch.log</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>WorkingDirectory</key>
	<string>/Users/nicolasgilbert/workspace/wev-health-watch</string>
</dict>
</plist>
