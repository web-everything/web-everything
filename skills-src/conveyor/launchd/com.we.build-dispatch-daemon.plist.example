<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	STAGED, NOT INSTALLED. Example launchd plist for the standalone BUILD-DISPATCH daemon
	(we:skills-src/conveyor/build-dispatch-daemon.mjs, #3984 slice 1). The operator fills the placeholders and
	copies it to ~/Library/LaunchAgents/com.we.build-dispatch-daemon.plist themselves — no session installs it.

	BEFORE INSTALLING:
	  1. Create the automation's CONTROL CLONE (never the primary checkout, never a lane) — the one clone the
	     automation executes code from (we:scripts/lib/automation-home.mjs#controlClonePath; the gh shim's throttle
	     CLI resolves here too). This daemon runs FROM it with --self-sync, so the daemon rebuild machinery keeps it
	     on origin/main between ticks (same machinery as the review daemon):
	       git clone https://github.com/web-everything/web-everything /Users/nicolasgilbert/workspace/wev-control
	     then `npm ci` in it.
	  2. Move the cleared queue out of the primary checkout, once (the old file is left untouched):
	       node scripts/conveyor/queue.mjs migrate --dry-run   # then without --dry-run
	  3. Dry run first, from that clone:
	       node skills-src/conveyor/build-dispatch-daemon.mjs --dry-run
	  4. Fill the GitHub App placeholders (never commit real values).
	  5. CONVEYOR_STATE_ROOT is the automation's state home (~/.claude/daemon-self-sync-state/conveyor-state) —
	     the queue's DEFAULT location now (decouple-primary-checkout, epic #4075), pinned here only so it is visible.
	     NEVER point it at the primary checkout again. OPERATION_RUNS_DIR pins dispatch-lane's run records OUTSIDE
	     the clone, so a self-sync rebuild cannot wipe the in-flight records (and the durable claims already live
	     under the coordination root).
	  6. Kill switch: `touch ~/workspace/.operations/coordination/build-dispatch-daemon.kill` freezes new
	     dispatches on the next tick without unloading the job; `rm` it to resume. `--live` is what allows
	     dispatch at all; drop it (or unload) to stop for good.
	  7. While this daemon runs, do NOT also execute the runner's surfaced `spawnBuilds` by hand — the durable
	     claim only fences dispatchers that take it (a later slice moves the claim into dispatch-lane itself).
	-->
	<key>Label</key>
	<string>com.we.build-dispatch-daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nicolasgilbert/.nvm/versions/node/v22.1.0/bin/node</string>
		<string>/Users/nicolasgilbert/workspace/wev-control/skills-src/conveyor/build-dispatch-daemon.mjs</string>
		<string>--live</string>
		<string>--self-sync</string>
		<string>--max-concurrent=3</string>
		<string>--max-open-prs=12</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/nicolasgilbert/.nvm/versions/node/v22.1.0/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>WE_BUILD_DISPATCH_MODE</key>
		<string>mechanical</string>
		<key>CONVEYOR_STATE_ROOT</key>
		<string>/Users/nicolasgilbert/.claude/daemon-self-sync-state/conveyor-state</string>
		<key>OPERATION_RUNS_DIR</key>
		<string>/Users/nicolasgilbert/workspace/.operations/coordination/build-dispatch-runs</string>
		<key>WE_GITHUB_APP_ID</key>
		<string>&lt;app-id&gt;</string>
		<key>WE_GITHUB_APP_INSTALLATION_ID</key>
		<string>&lt;installation-id&gt;</string>
		<key>WE_GITHUB_APP_PRIVATE_KEY_PATH</key>
		<string>&lt;path-to-private-key.pem&gt;</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/nicolasgilbert/workspace/wev-control</string>
	<key>StandardOutPath</key>
	<string>/Users/nicolasgilbert/workspace/.operations/coordination/build-dispatch-daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/nicolasgilbert/workspace/.operations/coordination/build-dispatch-daemon.log</string>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
