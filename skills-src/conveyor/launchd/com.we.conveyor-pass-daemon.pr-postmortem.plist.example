<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- INSTALL: replace every placeholder with operator-provided values, copy without
       .example into ~/Library/LaunchAgents, then bootstrap with launchctl.
       Inspect the log for incomplete evidence or pending publication requiring an operator.
       STOP: launchctl bootout gui/$(id -u)/com.we.conveyor-pass-daemon.pr-postmortem -->
  <key>Label</key><string>com.we.conveyor-pass-daemon.pr-postmortem</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WE_DAEMON_RESTART_MIN_INTERVAL_MS</key><string>120000</string>
    <key>PASS_DAEMON_SELF_SYNC</key><string>1</string>
    <key>PATH</key><string>&lt;node-bin-directory&gt;:/usr/bin:/bin</string>
    <key>WE_GITHUB_APP_ID</key><string>&lt;app-id&gt;</string>
    <key>WE_GITHUB_APP_INSTALLATION_ID</key><string>&lt;installation-id&gt;</string>
    <key>WE_GITHUB_APP_PRIVATE_KEY_PATH</key><string>&lt;path-to-private-key.pem&gt;</string>
    <key>WE_CORONER_STATE_DIR</key><string>&lt;coroner-state-directory&gt;</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>&lt;node-executable&gt;</string>
    <string>&lt;checkout&gt;/scripts/conveyor/pass-daemons/pr-postmortem-pass.mjs</string>
    <string>--repo=&lt;owner&gt;/&lt;repo&gt;</string>
    <string>--watch</string>
  </array>
  <key>WorkingDirectory</key><string>&lt;checkout&gt;</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>&lt;log-directory&gt;/pr-postmortem.log</string>
  <key>StandardErrorPath</key><string>&lt;log-directory&gt;/pr-postmortem.log</string>
</dict>
</plist>
