{
  "name": "web-everything",
  "version": "1.0.0",
  "description": "Web Everything - Grouping standards for better web library standardization",
  "customElements": "custom-elements.json",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "bootstrap": "node scripts/bootstrap-session.mjs",
    "bootstrap:install": "node scripts/bootstrap-session.mjs install",
    "bootstrap:uninstall": "node scripts/bootstrap-session.mjs uninstall",
    "bootstrap:check": "node scripts/bootstrap-session.mjs --check",
    "skills:sync": "node scripts/sync-skills-deploy.mjs",
    "skills:sync:check": "node scripts/sync-skills-deploy.mjs --check",
    "commands:sync": "node scripts/sync-commands-deploy.mjs",
    "commands:sync:check": "node scripts/sync-commands-deploy.mjs --check",
    "dev": "concurrently --restart-tries -1 --restart-after 1500 --names DOCS,DEMO,ACTIVE --prefix-colors blue,magenta,green \"npx @11ty/eleventy --serve --port=${WE_ELEVENTY_PORT:-8080} --quiet\" \"vite --port ${WE_VITE_PORT:-3000}\" \"node scripts/dev/active-progress-watch.mjs\"",
    "dev:docs": "eleventy --serve --port=${WE_ELEVENTY_PORT:-8080} --quiet",
    "dev:vite": "vite --port ${WE_VITE_PORT:-3000}",
    "dev:active-progress": "node scripts/dev/active-progress-watch.mjs",
    "build": "node scripts/readiness/heavy-admission.mjs run -- sh -c 'npm run build:docs && npm run build:demo'",
    "build:docs": "eleventy",
    "build:check": "eleventy --output=/tmp/we-build-check --quiet",
    "verify": "node scripts/readiness/heavy-admission.mjs run -- vitest run && npm run check:cold-start && npm run build:check",
    "build:demo": "vite build",
    "check:cold-start": "node scripts/dev/check-cold-start.mjs",
    "start": "npm run dev",
    "clean": "rm -rf _site",
    "test": "vitest",
    "test:bun:scripts": "npx --yes bun@1.4.2 test --isolate --preload ./bun-test.preload.ts scripts/__tests__",
    "test:unit": "node scripts/readiness/heavy-admission.mjs run -- vitest run",
    "test:integration:vitest": "node scripts/readiness/heavy-admission.mjs run -- vitest run --config vitest.integration.config.ts",
    "test:live": "node scripts/readiness/heavy-admission.mjs run -- vitest run --config vitest.live.config.ts",
    "test:soak": "node scripts/readiness/heavy-admission.mjs run -- vitest run --config vitest.soak.config.ts",
    "test:soak:shard": "node scripts/readiness/heavy-admission.mjs run -- node scripts/conveyor/soak/run-shard.mjs",
    "test:integration": "node scripts/readiness/heavy-admission.mjs run -- playwright test",
    "test:e2e": "node scripts/readiness/heavy-admission.mjs run -- playwright test --project=chromium",
    "test:smoke": "node scripts/readiness/heavy-admission.mjs run -- playwright test --project=chromium tests/smoke",
    "test:a11y": "node scripts/readiness/heavy-admission.mjs run -- playwright test --project=chromium tests/a11y",
    "regression": "node scripts/dev/regression.mjs",
    "check:visual": "playwright test --project=chromium tests/visual",
    "check:visual:update": "playwright test --project=chromium tests/visual --update-snapshots",
    "check:render": "node scripts/dev/render-check.mjs",
    "test:interaction": "node scripts/readiness/heavy-admission.mjs run -- playwright test --project=interaction",
    "test:coverage": "node scripts/readiness/heavy-admission.mjs run -- vitest run --coverage",
    "test:coverage:shard": "node scripts/readiness/heavy-admission.mjs run -- vitest run --coverage --coverage.reporter=json --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "gen:inventory": "node scripts/gen-inventory.mjs",
    "gen:inventory:staged": "node scripts/gen-inventory.mjs --staged",
    "gen:decision-docket": "node scripts/gen-decision-docket.mjs all",
    "gen:reference-index": "node scripts/gen-reference-index.mjs",
    "gen:dispatch-routing-table": "node scripts/gen-dispatch-routing-table.mjs",
    "sweep:references": "node scripts/sweep-reference-liveness.mjs",
    "route:references": "node scripts/route-reference-remediation.mjs",
    "check:axis-vacancy": "node scripts/check-axis-vacancy.mjs",
    "pin:references": "node scripts/pin-reference-snapshots.mjs",
    "gen:maas-openapi": "node scripts/gen-maas-openapi.mjs",
    "gen:webdirectives-ssr-vectors": "node scripts/gen-webdirectives-ssr-vectors.mjs",
    "review:clear": "node scripts/review-set-label.mjs --to=clear-human",
    "review:ledger-check": "node scripts/review-ledger-check.mjs",
    "converge:pass": "node scripts/converge-daemon-pass.mjs",
    "converge:daemon": "node scripts/converge-daemon-install.mjs",
    "pr-status": "node scripts/pr-status.mjs",
    "check:standards": "node scripts/readiness/heavy-admission.mjs run -- node scripts/check-standards.mjs",
    "check:statute": "node scripts/check-statute.mjs",
    "check:backlog-workflow": "node scripts/check-backlog-workflow.mjs",
    "check:memory": "node scripts/check-memory.mjs",
    "check:memory-freshness": "node scripts/check-memory-freshness.mjs",
    "reflect": "node scripts/memory-reflect.mjs",
    "harvest": "node scripts/conveyor/learnings-harvest.mjs",
    "harvest:status": "node scripts/conveyor/learnings-harvest.mjs --status",
    "check:item": "node scripts/check-backlog-item.mjs",
    "check:app-conformance": "node scripts/check-app-conformance.mjs",
    "check:demos": "node scripts/check-demos.mjs",
    "check:fresh": "node scripts/dev/check-fresh.mjs",
    "ingest:component": "node scripts/ingest-adapter/cli.mjs",
    "check:validation-adherence": "node scripts/readiness/heavy-admission.mjs run -- vitest run capability-manifest/__tests__/check.test.ts",
    "validation:see": "node scripts/validation-normalize/live-config.mjs",
    "check:readiness": "node scripts/check-readiness.mjs",
    "check:health": "node scripts/audit-backlog-health.mjs",
    "lint:locus": "node scripts/lint-locus-prefix.mjs --staged",
    "fix:readiness": "node scripts/check-readiness.mjs --apply",
    "propose:readiness": "node scripts/propose-readiness.mjs",
    "normalize:graduated": "node scripts/normalize-graduated.mjs",
    "autofix": "node scripts/conformance-autofix.mjs",
    "parity:score": "node scripts/parity-conformance.mjs",
    "parity:check": "node scripts/parity-conformance.mjs --check",
    "grammar:score": "node scripts/grammar-scorecard.mjs",
    "grammar:check": "node scripts/grammar-scorecard.mjs --check",
    "design-refs": "node scripts/design-refs.mjs",
    "design-refs:frontier": "node scripts/design-refs/frontier.mjs",
    "gen:wrapper": "node scripts/gen-wrapper/cli.mjs",
    "gen:cem": "node scripts/gen-cem.mjs",
    "mine:corpus": "node scripts/mine-golden-corpus.mjs",
    "replay:session": "node scripts/session-replay.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.2.0",
    "@axe-core/playwright": "^4.11.3",
    "@parcel/config-default": "^2.16.4",
    "@parcel/core": "^2.16.4",
    "@parcel/plugin": "^2.16.4",
    "@playwright/test": "^1.40.0",
    "@vitest/coverage-v8": "^1.0.0",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.21.5",
    "gray-matter": "4.0.3",
    "happy-dom": "^12.10.0",
    "istanbul-lib-coverage": "3.2.2",
    "js-yaml": "3.14.2",
    "linkedom": "0.14.26",
    "markdown-it": "13.0.2",
    "miniflare": "4.20260630.0",
    "playwright": "1.58.1",
    "urlpattern-polyfill": "^10.1.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "webpack": "^5.107.2",
    "wrangler": "^4.106.0"
  },
  "keywords": [
    "web-standards",
    "web-components",
    "polylfill",
    "dependency-injection"
  ],
  "author": "Web Everything Project",
  "license": "Apache-2.0",
  "dependencies": {
    "detect-gpu": "^5.0.70",
    "typescript": "^5.9.3",
    "web-features": "^3.30.0"
  }
}
