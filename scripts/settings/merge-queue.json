{
  "mergeDelivery": {
    "strategy": "github-merge-queue",
    "batchSize": 5,
    "maxGroupWaitMinutes": 5,
    "mergeMethod": "merge"
  },
  "mergeQueue": {
    "enabled": true,
    "batchSize": 1,
    "classOrder": ["main-fix", "normal"],
    "defaultClass": "normal",
    "strategy": "drain-direct"
  },
  "mergeFreshness": {
    "enabled": true,
    "maxAgeMinutes": 30,
    "allowDisjointMainMoves": true,
    "retestMode": "affected",
    "nonCodePaths": ["backlog/", "docs/"]
  }
}
