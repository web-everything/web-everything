      "label": "com.we.verify-daemon",
      "program": [
        "{node}",
        "{home}/workspace/wev-control/skills-src/conveyor/verify-daemon.mjs"
      ],
      "workingDir": "{home}/workspace/wev-control",
      "runAtLoad": true,
      "keepAlive": true,
      "throttleInterval": 60,
      "processType": "Standard",
      "stdout": "{home}/workspace/.operations/coordination/verify-daemon.log",
      "stderr": "{home}/workspace/.operations/coordination/verify-daemon.log",
      "env": {
        "WE_VERIFY_RELATED": "import-only",
        "WE_DAEMON_RESTART_MIN_INTERVAL_MS": "120000",
        "CONVEYOR_STATE_ROOT": "{home}/.claude/daemon-self-sync-state/conveyor-state",
        "WE_VERIFY_TEST_TIMEOUT_FACTOR": "3",
        "WE_VERIFY_STANDARDS": "auto"
      },
      "hostEnvKeys": [
        "WE_GITHUB_APP_ID",
        "WE_GITHUB_APP_INSTALLATION_ID",
        "WE_GITHUB_APP_KEY_DIR",
        "WE_GITHUB_APP_PRIVATE_KEY_PATH"
      ]
    },
    {
      "label": "com.webeverything.claude-otel-collector",
      "program": [
        "{node}",
        "{home}/workspace/wev-host-sampler/scripts/operations/claude-otel-collector.mjs",
        "--port=4318"
      ],
      "workingDir": "{home}/workspace/wev-host-sampler",
      "runAtLoad": true,
      "keepAlive": true,
      "throttleInterval": 60,
      "stdout": "{home}/Library/Logs/claude-otel-collector.log",
      "stderr": "{home}/Library/Logs/claude-otel-collector.log",
      "env": {
        "OPERATION_CLAUDE_OTEL_DIR": "{home}/workspace/webeverything/.operations/claude-otel"
      }
    },
    {
      "label": "com.webeverything.host-sampler",
      "program": [
        "{node}",
        "{home}/workspace/wev-host-sampler/scripts/operations/host-sampler.mjs",
        "loop",
        "--interval=30"
      ],
      "workingDir": "{home}/workspace/wev-host-sampler",
      "runAtLoad": true,
      "keepAlive": true,
      "throttleInterval": 30,
      "stdout": "{home}/Library/Logs/webeverything/host-sampler.out.log",
      "stderr": "{home}/Library/Logs/webeverything/host-sampler.err.log"
    }
  ]
}
