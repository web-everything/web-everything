        "DRAIN_DAEMON_PASS_TIMEOUT_MIN": "45",
        "DRAIN_DAEMON_WE_PRIMARY": "{home}/workspace/webeverything"
      },
      "hostEnvKeys": [
        "WE_GITHUB_APP_ID",
        "WE_GITHUB_APP_INSTALLATION_ID",
        "WE_GITHUB_APP_KEY_DIR",
        "WE_GITHUB_APP_PRIVATE_KEY_PATH",
