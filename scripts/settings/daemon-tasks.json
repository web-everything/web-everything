      "program": [
        "/bin/zsh",
        "-lc",
        "cd \"$WE_WIP_PUBLISH_HOME/workspace/plateau-app\" && { git pull --ff-only --quiet || echo \"wip-publisher: git pull skipped (offline or local changes) — running the code on disk\"; } && exec npm run --silent wip:publish"
