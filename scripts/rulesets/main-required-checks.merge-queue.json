{
  "name": "main: required checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "test",
            "integration_id": 15368
          },
          {
            "context": "smoke",
            "integration_id": 15368
          },
          {
            "context": "daemon-soak",
            "integration_id": 15368
          },
          {
            "context": "soak-replay-gate",
            "integration_id": 15368
          },
          {
            "context": "merge-gate",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "MERGE",
        "max_entries_to_build": 5,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 5,
        "min_entries_to_merge_wait_minutes": 5,
        "grouping_strategy": "ALLGREEN",
        "check_response_timeout_minutes": 60
      }
    },
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "path": ".github/workflows/ci.yml",
            "repository_id": 1142650361,
            "ref": "refs/heads/main"
          },
          {
            "path": ".github/workflows/merge-gate.yml",
            "repository_id": 1142650361,
            "ref": "refs/heads/main"
          },
          {
            "path": ".github/workflows/soak-replay-gate.yml",
            "repository_id": 1142650361,
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
